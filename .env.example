# Upstash Redis (REST) — local development / integration tests of @t2em/relay-server.
# Copy to .env (gitignored) and fill from the Upstash console.
# NEVER commit real values.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>

# Local relay port for @hono/node-server entry (optional)
T2EM_PORT=8787
