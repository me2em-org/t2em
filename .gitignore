# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files — NEVER commit secrets
# (Upstash REST tokens, Wrangler secrets live here in development)
.env
.env.*
!.env.example

# Build output
dist
.output

# Wrangler / Cloudflare local state
.wrangler/

# pnpm
.pnpm-store

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# NOTE: unlike me2em-protocol, docs/ is NOT ignored here:
# docs/ holds the source TZ documents (TZ_t2em.md, TZ_we2em.md).
