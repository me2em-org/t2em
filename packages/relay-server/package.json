{
  "name": "@t2em/relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Blind Relay of t2em.com: Hono app shared by Cloudflare Workers (worker.ts) and self-hosted Node (node.ts) entries",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@t2em/protocol": "workspace:^",
    "@upstash/redis": "^1.41.0",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
