{
  "name": "@t2em/cli",
  "version": "0.1.0",
  "description": "t2em-cli — command line client for t2em.com (push/pull/keygen/delete, UNIX pipes, ТЗ §8.2)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "t2em-cli": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@me2em/crypto": "1.1.0-rc.2",
    "@t2em/protocol": "workspace:^"
  },
  "devDependencies": {
    "@t2em/relay-server": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
